# Server Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=your-super-secure-jwt-secret-here-at-least-32-characters-long
DATABASE_URL=sqlite.db
# Comma-separated allowlist for browser origins that can call auth APIs cross-origin.
# Leave empty for same-origin deployments.
CLIENT_ORIGIN=

# Payment Providers (optional - at least one required for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# AI Services (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Error tracking (optional)
ERROR_TRACKING_WEBHOOK=
VITE_ERROR_TRACKING_WEBHOOK=

# Discord Integration (optional)
DISCORD_GUILD_ID=your_discord_guild_id_here

# Public site origin used for Steam OpenID return_to and realm.
# Set this to the live canonical URL, e.g. https://night-dev-web2.vercel.app
SITE_ORIGIN=https://night-dev-web2.vercel.app

# Steam Web API key from https://steamcommunity.com/dev/apikey
# Used for (1) live NightRespawnPilot status via IGameServersService/GetServerList and
# (2) Steam persona name and avatar lookup after OpenID login.
# Resolved as STEAM_API_KEY first, then the admin setting steam_api_key.
# Without a key, server status is Unknown / not verified. Steam login still works without it.
STEAM_API_KEY=

# Legacy options (may be deprecated)
# APP_URL is also accepted as a fallback public origin for Steam OpenID.
APP_URL=
RESET_DB=false
VITE_ENABLE_STUDIO=false
VITE_API_BASE_URL=

# SMTP mail configuration for transactional emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="no-reply@example.com"

# Optional support contact shown in welcome email template.
SUPPORT_EMAIL="support@example.com"

# NightRespawnPilot private Unturned playtest server.
# The Server Code is a 17-digit Steam game-server ID and changes on every dedicated-server restart.
# Update NIGHTRESPAWN_PILOT_SERVER_CODE after a restart, or set NIGHTRESPAWN_PILOT_ENABLED=false to hide it.
# NIGHTRESPAWN_PILOT_INTERNAL_ADDRESS is informational; players join by Server Code, not this address.
NIGHTRESPAWN_PILOT_ENABLED=true
NIGHTRESPAWN_PILOT_SERVER_CODE=90298158635345928
NIGHTRESPAWN_PILOT_INTERNAL_ADDRESS=172.30.0.2:27015

# Turso/LibSQL (production on Vercel). Used when DATABASE_URL or TURSO_DATABASE_URL starts with libsql://.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Payment test and webhook verification (optional). Store checkout in the UI is still simulated.
# MOCK_PAYMENTS=1
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_WEBHOOK_SECRET=
